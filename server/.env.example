# Copy this file to .env and fill in the values.
# Never commit your real .env file to version control.

# Server
PORT=5000
NODE_ENV=development

# MongoDB — used for User authentication data (Mongoose)
MONGO_URI=mongodb://127.0.0.1:27017/ai-expense-tracker

# SQLite / Prisma — used for Expense & Category data
DATABASE_URL="file:./dev.db"

# Google Gemini API key — obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# JWT signing secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here
